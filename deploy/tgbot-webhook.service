[Unit]
Description=TG Bot Webhook Server
After=network.target

[Service]
Type=simple
User=tgbot
Group=tgbot
WorkingDirectory=/opt/tgbot/deploy
ExecStart=/usr/bin/python3 /opt/tgbot/deploy/webhook_server.py
EnvironmentFile=/opt/tgbot/.env
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
